# .env.example — 이 파일을 복사해 .env 를 만들고 값을 채우세요. (.env 는 Git에 올라가지 않습니다)
#   cp .env.example .env
#
# Expo는 EXPO_PUBLIC_ 로 시작하는 변수만 앱 번들에 넣습니다.
# 앱 코드에서는 반드시 점 표기법으로 읽어야 합니다: process.env.EXPO_PUBLIC_SUPABASE_URL
# (process.env['...'] 나 구조분해 할당은 동작하지 않습니다)
#
# ⚠️ EXPO_PUBLIC_ 값은 빌드된 앱 안에 평문으로 들어가 누구나 볼 수 있습니다.
#    Supabase service_role 키, secret 키, DB 비밀번호 등 서버 비밀키는 이 파일과 앱 코드에 절대 넣지 마세요.
#    서버 비밀키는 Supabase Edge Function 시크릿으로만 관리합니다.

# Supabase 프로젝트 URL (Supabase 대시보드 > Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase 공개용 클라이언트 키 (publishable 키, 또는 레거시 anon 키). RLS 정책으로 보호되는 공개 키입니다.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# (개발용) Mock 시나리오. 서버 없이 Guest·오프라인·오류·가격 변경·품절 같은 상태를 화면에서 확인할 때 씁니다.
# 비워 두면 default(Guest, 정상 응답). 값을 바꾼 뒤에는 개발 서버를 다시 시작하세요: npx expo start -c
#   default · member · memberNoAccount · slow · offline · error · homeEmpty · homeSectionError
#   cartPriceChanged · cartMenuSoldOut · cartOptionSoldOut · cartInactive · cartOptionsInvalid
#   cartValidationUnavailable · cartOffline · cartSaveFails
#   (주문 흐름) loginInvalid · loginNetwork · loginHasAccount · accountSaveFails
#   orderLocalSaveFails · orderUnknownLost · orderUnknownCreated · orderPriceChanged · orderItemUnavailable
#   killSwitch · configTimeout · tossLaunchFails · statusQueryFails · returnAlreadyConfirmed · returnAlreadyCancelled
#   confirmSaveFails · cancelUnknown · clipboardFails
#   (내역·리뷰) historyEmpty · historyFirstPageFails · historyNextPageFails · historyLong · readSaveFails · monthlyFails
#   reviewsEmpty · reviewListFails · myReviewsEmpty · myReviewsFails · myReviewsLong · myReviewsNextPageFails
#   photoUploadFails · reviewSaveFails · reviewDeadlineExceeded · reviewConflict · reviewDeleteFails · helpfulFails
#   (검색·찜·마이·시작) searchFails · popularFails · popularEmpty · recentSeeded · categoryFails
#   favoritesEmpty · favoritesOnlyInactive · favoritesFails · favoriteSaveFails
#   myNewUser · myRecordFails · notifLoadFails · notifSaveFails · firstRun · launchReadFails
#   Guest로 시작하면 로그인부터, member로 시작하면 최종 주문 확인부터 볼 수 있습니다.
# 이 값은 앱 번들에 들어가는 공개 설정이며 비밀값이 아닙니다.
EXPO_PUBLIC_MOCK_SCENARIO=
